{
  "name": "lightweight-ui",
  "version": "0.1.0",
  "description": "Lightweight UI — a small React UI kit: tokens, typography, colour, motion and components.",
  "license": "MIT",
  "author": "ayaneshu (https://github.com/ayaneshu)",
  "homepage": "https://lightweight-ui-kit.vercel.app",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./icons/ssr": {
      "types": "./dist/icons-ssr.d.ts",
      "import": "./dist/icons-ssr.js",
      "require": "./dist/icons-ssr.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "lightweight-ui": "./bin/lightweight-ui.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup && node scripts/build-css.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p playground/tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "keywords": [
    "design-system",
    "ui-kit",
    "react",
    "tailwindcss",
    "components",
    "phosphor-icons"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayaneshu/lightweight-ui-kit.git"
  }
}
