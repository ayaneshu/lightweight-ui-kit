{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "lightweight-ui": [
        "../src/index.ts"
      ],
      "lightweight-ui/icons": [
        "../src/icons.ts"
      ],
      "lightweight-ui/tokens": [
        "../src/tokens/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
